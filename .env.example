# Copy this file to ".env" and fill in your own values.
# Never commit your real ".env" file to GitHub.

# MongoDB Atlas connection string (from your Atlas cluster's "Connect" > "Drivers" screen)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/hartahub?retryWrites=true&w=majority

# Any long random string - used to sign login session cookies
SESSION_SECRET=change-this-to-a-long-random-string

# Port the server runs on locally (Render sets this automatically in production)
PORT=3000

# Cloudinary - used for Pro/Premium photo uploads (free tier is enough).
# Get these three from your Cloudinary dashboard after signing up free
# at cloudinary.com - see README "Photo uploads (Cloudinary)".
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# bcl.my (BayarCash) - used for Pro/Premium plan upgrades (routes/billing.js).
# Both come from the bcl.my dashboard: Platform Setup > Integrations >
# API Token tab (create a token with api:read + api:write) for BCL_API_TOKEN,
# and Platform Setup > Payment (or any existing form's details) for the
# portal key, BCL_PORTAL_KEY.
BCL_API_TOKEN=bcl_your-api-token
BCL_PORTAL_KEY=your-32-char-portal-key
